@model TypicalTechTools.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="d-flex justify-content-between">
    <h1>@Model.ProductName</h1>
    <a asp-action="Index" class="btn btn-secondary align-self-start">Back to products</a>
</div>
<dl class="row">
    <dt class="col-sm-3">Product Code</dt>
    <dd class="col-sm-9">@Model.ProductId</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.ProductPrice.ToString("C2")</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.ProductDescription</dd>

    <dt class="col-sm-3">Updated Date</dt>
    <dd class="col-sm-9">@Model.UpdatedDate.ToString("dd/MM/yyyy hh:mm tt")</dd>
</dl>

<div class="mb-4">
    <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-primary">Edit product</a>
</div>

<hr class="opacity-50 my-5">

<div class="d-flex justify-content-between align-items-center">
    <h2>Reviews</h2>
    <a asp-controller="Review"
       asp-action="AddReview"
       asp-route-productCode="@Model.ProductId"
       class="btn btn-primary">Add review</a>
</div>

@if (Model.Reviews.Count == 0)
{
    <p class="text-secondary">No reviews have been added for this product.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Review</th>
            <th>Created Date</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var review in Model.Reviews.OrderByDescending(review => review.CreatedDate))
        {
            <tr>
                <td>@review.ReviewText</td>
                <td>@review.CreatedDate.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        </tbody>
    </table>
}

