@model IEnumerable<TypicalTechTools.Models.Review>
@using Microsoft.AspNetCore.Http;

@{
    ViewData["Title"] = "ReviewList";
    // extract variables from the ViewBag
    int productCode = ViewBag.ProductCode;
    string productName = ViewBag.ProductName;
    
}


<h1>Reviews for @productName</h1>
<p class="opacity-50">Product code: @productCode</p>
<a asp-action="AddReview" asp-route-productCode="@productCode" class="btn btn-primary">Add a review</a>

<div class="my-5">
    @if (!Model.Any())
    {
        <p class="text-secondary">No reviews have been added for this product.</p>
    }
    else
    {
        <table class="table">
            <thead>
            <tr class="">
                <th>
                    @Html.DisplayNameFor(model => model.ReviewText)
                </th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @Html.HiddenFor(modelItem => item.ReviewId)
                    @Html.HiddenFor(modelItem => item.ProductId)
                    <td>
                        @Html.DisplayFor(modelItem => item.ReviewText)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedDate)
                    </td>
                    <td class="d-flex flex-wrap gap-1">
                        @Html.ActionLink("Edit", "EditReview", new { reviewId = item.ReviewId }, new { @class = "btn btn-outline-primary" })
                        @Html.ActionLink("Delete", "RemoveReview", new { reviewId = item.ReviewId }, new { @class = "btn btn-danger" })
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>