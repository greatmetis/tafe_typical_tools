@model IEnumerable<TypicalTechTools.Models.Review>
@using Microsoft.AspNetCore.Http;

@{
    ViewData["Title"] = "ReviewList";
    // extract variables from the ViewBag
    int productCode = ViewBag.ProductCode;
    string productName = ViewBag.ProductName;
    
}


<h1>Reviews for @productName</h1>
<p class="opacity-50">Product code: @productCode</p>
<a asp-action="AddReview" asp-route-productCode="@productCode" class="btn btn-primary">Add a review</a>

<div class="my-5">
    @if (!Model.Any())
    {
        <p class="text-secondary">No reviews have been added for this product.</p>
    }
    else
    {
        <table class="table">
            <thead>
            <tr class="">
                <th>
                    @Html.DisplayNameFor(model => model.ReviewText)
                </th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @Html.HiddenFor(modelItem => item.ReviewId)
                    @Html.HiddenFor(modelItem => item.ProductId)
                    <td>
                        @Html.DisplayFor(modelItem => item.ReviewText)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedDate)
                    </td>
                    <td class="d-flex flex-wrap gap-1">
                        @Html.ActionLink("Edit", "EditReview", new { reviewId = item.ReviewId }, new { @class = "btn btn-outline-primary" })
                        <button type="button"
                                class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteReviewModal-@item.ReviewId">
                            Delete
                        </button>
                        <div class="modal fade"
                             id="deleteReviewModal-@item.ReviewId"
                             tabindex="-1"
                             aria-labelledby="deleteReviewModalLabel-@item.ReviewId"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">

                                    <form asp-controller="Review"
                                          asp-action="RemoveReview"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="reviewId"
                                               value="@item.ReviewId" />

                                        <div class="modal-header">
                                            <h2 class="modal-title fs-5"
                                                id="deleteReviewModalLabel-@item.ReviewId">
                                                Delete review
                                            </h2>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal"
                                                    aria-label="Close">
                                            </button>
                                        </div>

                                        <div class="modal-body">
                                            <p>Are you sure you want to delete this review?</p>
                                            <p class="mb-0">
                                                <strong>@item.ReviewText</strong>
                                            </p>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal">
                                                Cancel
                                            </button>

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Delete review
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>