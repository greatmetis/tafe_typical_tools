@model TypicalTechTools.Models.Review

@{
    ViewData["Title"] = "EditReview";
    int productCode = ViewBag.ProductCode;
    string productName = ViewBag.ProductName;
    
}

<h1>Edit Review</h1>

<h4>Review for @productName</h4>
<p class="opacity-50">Product code: @productCode</p>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="EditReview">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(c => c.ReviewId)
            @Html.HiddenFor(c => c.ProductId)

            <div class="form-group mb-3">
                <label asp-for="ReviewText" class="control-label"></label>
                <textarea asp-for="ReviewText" class="form-control" ></textarea>
                <span asp-validation-for="ReviewText" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="ReviewList" asp-route-id="@Model.ProductId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
